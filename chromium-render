#!/usr/bin/env bash
# The browser for renders on the box (EDGE=/work/buildbox/chromium-render): Playwright's Chromium headless
# shell, which rc.sh installs when state/extras lists `chromium` (the NAS is arm64, and Edge has no arm64
# build for Linux). It is headless already, so --headless=new is dropped (the full Chromium never exits with
# it), and the box runs as root, where Chromium only starts with --no-sandbox.
shell="$(find "${PLAYWRIGHT_BROWSERS_PATH:-$HOME/.cache/ms-playwright}" -maxdepth 3 -type f -perm -u+x \
  \( -name headless_shell -o -name chrome-headless-shell \) -path '*chromium_headless_shell-*' 2>/dev/null | sort -V | tail -1)"
[ -n "$shell" ] || { echo "chromium-render: no headless shell; add chromium to /work/buildbox/state/extras and run rc.sh install" >&2; exit 1; }
args=()
for a in "$@"; do [ "$a" = --headless=new ] || args+=("$a"); done
exec "$shell" --no-sandbox "${args[@]}"
